{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "labtrust.verifier_assurance.HoldoutPartitionManifest.v1",
  "title": "HoldoutPartitionManifest v1",
  "description": "Sealed train/eval partition for verifier-assurance benchmark holdouts. Simulation/research only; not clinical validation. Eval holdouts must not leak episode content into public packs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "partition_id",
    "campaign_id",
    "train",
    "eval",
    "public_pack_policy",
    "claim_boundary"
  ],
  "properties": {
    "schema_id": { "const": "HoldoutPartitionManifest.v1" },
    "partition_id": { "type": "string", "minLength": 1 },
    "campaign_id": { "type": "string", "minLength": 1 },
    "partition_version": { "type": "string", "minLength": 1 },
    "rng_seed": { "type": ["integer", "null"] },
    "train": {
      "type": "object",
      "additionalProperties": false,
      "required": ["episode_ids"],
      "properties": {
        "episode_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "exploit_families": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "eval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["episode_ids", "sealed"],
      "properties": {
        "episode_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "exploit_families": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "sealed": { "const": true }
      }
    },
    "commitments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eval_set_commitment", "algorithm"],
      "properties": {
        "eval_set_commitment": { "type": "string", "minLength": 16 },
        "algorithm": { "const": "sha256" },
        "salt_hex": { "type": "string", "minLength": 16 },
        "revealed": { "type": "boolean" }
      }
    },
    "public_pack_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exclude_eval_episode_content",
        "allow_eval_commitments_only",
        "forbid_eval_ids_in_train_artifacts"
      ],
      "properties": {
        "exclude_eval_episode_content": { "const": true },
        "allow_eval_commitments_only": { "const": true },
        "forbid_eval_ids_in_train_artifacts": { "const": true }
      }
    },
    "partition_digest": {
      "type": "string",
      "description": "Optional precomputed digest; loaders recompute and bind."
    },
    "claim_boundary": {
      "type": "string",
      "const": "simulation_research_only_no_clinical_validation"
    }
  }
}
