{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "labtrust.golden_scenarios.v0.1",
  "title": "Golden scenarios structure v0.1",
  "description": "Schema for policy/golden/golden_scenarios.v0.1.yaml including LTG-PR3 governance metadata.",
  "type": "object",
  "required": ["golden_suite"],
  "additionalProperties": true,
  "properties": {
    "golden_suite": {
      "type": "object",
      "required": ["scenarios"],
      "additionalProperties": true,
      "properties": {
        "version": { "type": "string" },
        "deterministic": { "type": "object" },
        "depends_on": { "type": "array", "items": { "type": "string" } },
        "runner_contract": { "type": "object" },
        "fixtures": { "type": "object" },
        "governance": {
          "type": "object",
          "description": "Suite-level governance pointers (LTG-PR3).",
          "additionalProperties": true,
          "properties": {
            "matrix_ref": { "type": "string", "minLength": 1 },
            "policy_version": { "type": "string", "minLength": 1 },
            "change_control_doc": { "type": "string", "minLength": 1 }
          }
        },
        "scenarios": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "scenario_id",
              "initial_state",
              "script",
              "governance"
            ],
            "additionalProperties": true,
            "properties": {
              "scenario_id": { "type": "string", "minLength": 1 },
              "title": { "type": "string" },
              "governance": {
                "type": "object",
                "description": "Per-scenario governance metadata (LTG-PR3). scenario_id and initial_state live on the scenario root; action_sequence must match script action_type order.",
                "required": [
                  "hazard",
                  "policy_version",
                  "action_sequence",
                  "expected_reason_codes",
                  "expected_terminal_state",
                  "required_evidence",
                  "coverage_class",
                  "reviewer"
                ],
                "additionalProperties": false,
                "properties": {
                  "hazard": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Short hazard framing for this scenario (not a clinical claim)."
                  },
                  "policy_version": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Golden suite / policy pack version this scenario is pinned to."
                  },
                  "action_sequence": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "string", "minLength": 1 },
                    "description": "Ordered action_type list; must equal script[*].action_type."
                  },
                  "expected_reason_codes": {
                    "type": "array",
                    "items": { "type": "string", "minLength": 1 },
                    "description": "Reason codes this scenario asserts (blocked_reason_code and/or last_reason_code). Empty when none."
                  },
                  "expected_terminal_state": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Inspectable terminal outcome summary after the script."
                  },
                  "required_evidence": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "string", "minLength": 1 },
                    "description": "Evidence artifacts or assertions required to accept this scenario as coverage."
                  },
                  "coverage_class": {
                    "type": "string",
                    "enum": [
                      "specimen_identity",
                      "chain_of_custody",
                      "quality_control_release",
                      "critical_result_escalation",
                      "stability_windows",
                      "role_authorization",
                      "zone_access",
                      "token_validity",
                      "catalog_drift",
                      "multi_site_handoff",
                      "adversarial_coordination",
                      "insider_misuse"
                    ],
                    "description": "Primary hazard coverage class; must appear in hazard_coverage_matrix for this scenario_id."
                  },
                  "reviewer": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Domain reviewer identity after a signed independent-review report, or pending-domain-review until then (see docs/reviews/charter.md). Do not invent approvals."
                  }
                }
              },
              "post_run_hooks": {
                "type": "array",
                "description": "Optional hooks run after script (before post_run): EXPORT_RECEIPTS, VERIFY_BUNDLE, EXPORT_FHIR. Deterministic for fixed seed; use stable temp paths.",
                "items": { "type": "string", "enum": ["EXPORT_RECEIPTS", "VERIFY_BUNDLE", "EXPORT_FHIR"] }
              },
              "post_run": {
                "type": "array",
                "description": "Optional post-episode actions (export, assert). Run after script steps succeed.",
                "items": {
                  "type": "object",
                  "required": ["action"],
                  "additionalProperties": true,
                  "properties": {
                    "action": { "type": "string", "enum": ["EXPORT_RECEIPTS", "EXPORT_FHIR", "ASSERT_FILE_EXISTS", "ASSERT_SCHEMA_VALID"] },
                    "out_dir": { "type": "string" },
                    "out_filename": { "type": "string" },
                    "path": { "type": "string" },
                    "schema": { "type": "string" }
                  }
                }
              },
              "initial_state": {
                "type": "object",
                "required": [],
                "additionalProperties": true,
                "properties": {
                  "system": { "type": "object" },
                  "agents": { "type": "array" },
                  "specimens": { "type": "array" },
                  "tokens": { "type": "array" }
                }
              },
              "script": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["event_id", "t_s", "agent_id", "action_type", "args", "reason_code", "token_refs"],
                  "additionalProperties": true,
                  "properties": {
                    "event_id": { "type": "string" },
                    "t_s": { "type": "integer" },
                    "agent_id": { "type": "string" },
                    "action_type": { "type": "string" },
                    "args": { "type": "object" },
                    "reason_code": {},
                    "token_refs": { "type": "array" },
                    "expect": { "type": "object" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
