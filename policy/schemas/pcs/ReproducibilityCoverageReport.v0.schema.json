{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pcs.sentinelops.ci/schemas/ReproducibilityCoverageReport.v0.schema.json",
  "title": "ReproducibilityCoverageReport.v0",
  "description": "Coverage summary for a reproducibility benchmark run.",
  "type": "object",
  "required": [
    "schema_version",
    "workflow_id",
    "task_id",
    "reproducibility_passed",
    "runs",
    "mode"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "v0" },
    "workflow_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "reproducibility_passed": { "type": "boolean" },
    "runs": { "type": "integer", "minimum": 1 },
    "mode": {
      "type": "string",
      "enum": ["hash_stability", "full_regeneration"]
    },
    "hash_stability_passed": { "type": "boolean" }
  }
}
