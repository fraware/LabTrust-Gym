{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "labtrust.hazard_coverage_matrix.v0.1",
  "title": "Hazard coverage matrix v0.1",
  "description": "Schema for policy/coverage/hazard_coverage_matrix.v0.1.yaml: hazard classes mapped to golden scenarios and security attacks, with explicit gaps.",
  "type": "object",
  "required": ["hazard_coverage_matrix"],
  "additionalProperties": false,
  "properties": {
    "hazard_coverage_matrix": {
      "type": "object",
      "required": ["matrix_id", "version", "hazards"],
      "additionalProperties": true,
      "properties": {
        "matrix_id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "coverage_enum": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["covered", "partially_covered", "uncovered", "not_applicable"]
          }
        },
        "hazards": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["hazard_class", "coverage", "golden_scenario_ids", "security_attack_ids"],
            "additionalProperties": true,
            "properties": {
              "hazard_class": {
                "type": "string",
                "enum": [
                  "specimen_identity",
                  "chain_of_custody",
                  "quality_control_release",
                  "critical_result_escalation",
                  "stability_windows",
                  "role_authorization",
                  "zone_access",
                  "token_validity",
                  "catalog_drift",
                  "multi_site_handoff",
                  "adversarial_coordination",
                  "insider_misuse"
                ]
              },
              "coverage": {
                "type": "string",
                "enum": ["covered", "partially_covered", "uncovered", "not_applicable"]
              },
              "golden_scenario_ids": {
                "type": "array",
                "items": { "type": "string" }
              },
              "security_attack_ids": {
                "type": "array",
                "items": { "type": "string" }
              },
              "gap": { "type": ["string", "null"] },
              "notes": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
