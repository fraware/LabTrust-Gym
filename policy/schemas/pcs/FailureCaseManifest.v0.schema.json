{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pcs.sentinelops.ci/schemas/FailureCaseManifest.v0.schema.json",
  "title": "FailureCaseManifest.v0",
  "description": "Metadata for one PCS workflow failure-gallery negative fixture.",
  "type": "object",
  "required": [
    "failure_case_id",
    "workflow_id",
    "expected_failure_code",
    "responsible_component",
    "artifacts",
    "repair_hint"
  ],
  "additionalProperties": false,
  "properties": {
    "failure_case_id": {
      "type": "string",
      "minLength": 1
    },
    "workflow_id": {
      "type": "string",
      "minLength": 1
    },
    "expected_failure_code": {
      "type": "string",
      "minLength": 1
    },
    "responsible_component": {
      "type": "string",
      "minLength": 1,
      "description": "Owning layer, e.g. workflow.runtime, workflow.handoff, certifyedge.certificate"
    },
    "artifacts": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "repair_hint": {
      "type": "string",
      "minLength": 1
    }
  }
}
