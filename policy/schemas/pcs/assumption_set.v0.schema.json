{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pcs.assumption_set.v0",
  "title": "PCS AssumptionSet v0",
  "type": "object",
  "required": [
    "artifact_kind",
    "version",
    "assumption_set_id",
    "assumptions",
    "source_repo",
    "source_commit",
    "assumption_set_digest"
  ],
  "properties": {
    "artifact_kind": { "const": "AssumptionSet" },
    "version": { "const": "0" },
    "assumption_set_id": { "type": "string" },
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["assumption_id", "text"],
        "properties": {
          "assumption_id": { "type": "string" },
          "text": { "type": "string" }
        }
      }
    },
    "source_repo": { "type": "string" },
    "source_commit": { "type": "string" },
    "assumption_set_digest": { "type": "string" }
  },
  "additionalProperties": true
}
