{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "labtrust.verifier_assurance.MutationProfile.v1",
  "title": "MutationProfile v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_id",
    "mutation_id",
    "source_profile_id",
    "target",
    "dimension",
    "operations",
    "rationale",
    "expected_effect",
    "production_prohibition",
    "claim_boundary"
  ],
  "properties": {
    "schema_id": { "const": "MutationProfile.v1" },
    "mutation_id": { "type": "string" },
    "source_profile_id": { "type": "string" },
    "target": { "enum": ["env", "verifier"] },
    "dimension": { "type": "string" },
    "operations": { "type": "array", "minItems": 1 },
    "rationale": { "type": "string" },
    "expected_effect": { "type": "string" },
    "production_prohibition": { "type": "boolean" },
    "claim_boundary": {
      "const": "simulation_research_only_no_clinical_validation"
    },
    "mutation_digest": { "type": "string" }
  }
}
