{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pcs.runtime_receipt.v0",
  "title": "PCS RuntimeReceipt v0",
  "type": "object",
  "required": [
    "artifact_kind",
    "version",
    "run_id",
    "environment",
    "started_at",
    "ended_at",
    "status",
    "events_hash",
    "policy_hash",
    "trace_hash",
    "producer",
    "producer_version",
    "source_repo",
    "source_commit",
    "input_hashes",
    "output_hashes",
    "signature_or_digest"
  ],
  "properties": {
    "artifact_kind": { "const": "RuntimeReceipt" },
    "version": { "const": "0" },
    "run_id": { "type": "string" },
    "environment": { "type": "object" },
    "started_at": { "type": "string" },
    "ended_at": { "type": "string" },
    "status": { "type": "string" },
    "events_hash": { "type": "string" },
    "policy_hash": { "type": "string" },
    "trace_hash": { "type": "string" },
    "producer": { "const": "LabTrust-Gym" },
    "producer_version": { "type": "string" },
    "source_repo": { "type": "string" },
    "source_commit": { "type": "string" },
    "input_hashes": { "type": "object" },
    "output_hashes": { "type": "object" },
    "signature_or_digest": { "type": "string" }
  },
  "additionalProperties": true
}
